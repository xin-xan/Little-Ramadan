{
  "name": "little-ramadan",
  "version": "1.0.0",
  "private": true,
  "description": "Little Ramadan — My Little Journey of Faith, Kindness & Discovery. A free, child-safe, offline-first Ramadan learning PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "vitest run tests/unit/content.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
