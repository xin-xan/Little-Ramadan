// Cloudflare Workers config: Little Ramadan is a fully static site (Next.js static export in ./out).
// No server code runs; Workers simply serves the files. Build with `npm run build`, deploy with `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-ramadan",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
